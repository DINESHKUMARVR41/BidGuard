# Copy this file to .env and fill in your own Firebase project values.
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-firebase-app-id

# Optional: required only for automated tender discovery
TINYFISH_API_KEY=

# Paths are relative to the project directory unless absolute paths are supplied
BIDGUARD_DATABASE=bidguard.db
BIDGUARD_UPLOAD_DIR=uploads
